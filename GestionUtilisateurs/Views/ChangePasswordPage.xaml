<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionUtilisateurs.ViewModels"
             x:Class="GestionUtilisateurs.Views.ChangePasswordPage"
             Title="Changer le mot de passe">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8" MaximumWidthRequest="500">

            <Label Text="Modifier mon mot de passe"
                   Style="{StaticResource PageTitleLabelStyle}" />

            <Label Text="Le mot de passe doit contenir au moins 6 caractères."
                   TextColor="{StaticResource Gray500}" Margin="0,0,0,12" />

            <!-- Messages -->
            <Border IsVisible="{Binding HasError}" BackgroundColor="#FDE7E7" StrokeShape="RoundRectangle 8" Padding="12">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabelStyle}" />
            </Border>
            <Border IsVisible="{Binding HasSuccess}" BackgroundColor="#E6F4EA" StrokeShape="RoundRectangle 8" Padding="12">
                <Label Text="{Binding SuccessMessage}" Style="{StaticResource SuccessLabelStyle}" />
            </Border>

            <Label Text="Mot de passe actuel" Style="{StaticResource FieldLabelStyle}" />
            <Entry Text="{Binding CurrentPassword}" IsPassword="True" Placeholder="Votre mot de passe actuel" Style="{StaticResource FieldEntryStyle}" />

            <Label Text="Nouveau mot de passe" Style="{StaticResource FieldLabelStyle}" />
            <Entry Text="{Binding NewPassword}" IsPassword="True" Placeholder="Nouveau mot de passe" Style="{StaticResource FieldEntryStyle}" />

            <Label Text="Confirmer le nouveau mot de passe" Style="{StaticResource FieldLabelStyle}" />
            <Entry Text="{Binding ConfirmNewPassword}" IsPassword="True" Placeholder="Confirmation" Style="{StaticResource FieldEntryStyle}" />

            <Button Text="Enregistrer"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,16,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Style="{StaticResource BusyIndicatorStyle}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>