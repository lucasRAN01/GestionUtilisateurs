<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:GestionUtilisateurs.ViewModels"
             x:Class="GestionUtilisateurs.Views.LoginPage"
             Title="Connexion">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">

            <Label Text="Gestion des utilisateurs"
                   Style="{StaticResource PageTitleLabelStyle}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,8" />

            <Label Text="Connectez-vous pour accéder à l'application"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource Gray500}"
                   FontSize="14"
                   Margin="0,0,0,16" />

            <!-- Zone d'erreur -->
            <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="6">
                <Border BackgroundColor="#FDE7E7" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorLabelStyle}"
                           HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Zone de succès -->
            <VerticalStackLayout IsVisible="{Binding HasSuccess}" Spacing="6">
                <Border BackgroundColor="#E6F4EA" StrokeShape="RoundRectangle 8" Padding="12">
                    <Label Text="{Binding SuccessMessage}"
                           Style="{StaticResource SuccessLabelStyle}"
                           HorizontalTextAlignment="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Nom d'utilisateur -->
            <Label Text="Nom d'utilisateur" Style="{StaticResource FieldLabelStyle}" />
            <Entry Text="{Binding Username}"
                   Placeholder="Entrez votre nom d'utilisateur"
                   Style="{StaticResource FieldEntryStyle}"
                   AutomationId="usernameEntry" />

            <!-- Mot de passe -->
            <Label Text="Mot de passe" Style="{StaticResource FieldLabelStyle}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry x:Name="PasswordEntry"
                       Text="{Binding Password}"
                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolConverter}}"
                       Placeholder="Entrez votre mot de passe"
                       Style="{StaticResource FieldEntryStyle}"
                       AutomationId="passwordEntry"
                       Grid.Column="0" />
                <Button Text="Afficher"
                        Command="{Binding TogglePasswordCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        HeightRequest="48"
                        VerticalOptions="End"
                        Grid.Column="1" />
            </Grid>

            <!-- Bouton de connexion -->
            <Button Text="Se connecter"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,16,0,0"
                    AutomationId="loginButton" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Style="{StaticResource BusyIndicatorStyle}"
                               Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>