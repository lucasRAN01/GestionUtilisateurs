<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:GestionUtilisateurs.Converters">

    <!-- ============ Convertisseurs ============ -->
    <converters:NullableDateTimeConverter x:Key="NullableDateTimeConverter" />
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
    <converters:UserStatusConverter x:Key="UserStatusConverter" />
    <converters:ToggleStatusTextConverter x:Key="ToggleStatusTextConverter" />
    <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
    <converters:BoolToColorConverter x:Key="StatusColorConverter" TrueColor="#2E7D32" FalseColor="#C62828" />

    <!-- ============ Styles du contenu général ============ -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource LightBackground}" />
    </Style>

    <!-- ============ Styles label ============ -->
    <Style x:Key="PageTitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
    </Style>

    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Gray600}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="ErrorLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SuccessLabelStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Success}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ============ Entry ============ -->
    <Style x:Key="FieldEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ============ Editeur multiligne ============ -->
    <Style x:Key="NotesEditorStyle" TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="HeightRequest" Value="100" />
    </Style>

    <!-- ============ Picker ============ -->
    <Style x:Key="FieldPickerStyle" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDarkText}" />
        <Setter Property="TitleColor" Value="{StaticResource Gray400}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- ============ Boutons ============ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="50" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryDark}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="46" />
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- ============ Cartes ============ -->
    <Style x:Key="CardFrameStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderLight}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
    </Style>

    <!-- ============ CollectionView / liste ============ -->
    <Style x:Key="ListItemStyle" TargetType="Border">
        <Setter Property="Stroke" Value="{StaticResource BorderLight}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BackgroundColor" Value="{StaticResource CardBackground}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ============ ActivityIndicator ============ -->
    <Style x:Key="BusyIndicatorStyle" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
        <Setter Property="IsRunning" Value="True" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ============ Entrée avec mot de passe ============ -->
    <Style x:Key="SearchBarStyle" TargetType="SearchBar">
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray400}" />
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

</ResourceDictionary>
